# Copy to .env and fill locally. Never commit .env or key material.
SMART_ROUTER_KEY=generate-a-long-random-local-secret
SMART_ROUTER_ENCRYPTION_KEY=generate-a-fernet-key-with-python
SMART_ROUTER_CONFIG=config.yaml
SMART_ROUTER_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:smart_router_secret@postgres:5432/smart_router
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=smart_router_secret
SMART_ROUTER_PORT=8320
WEB_PORT=80

# Upstream credentials (fill at least one for your deployment; keep values in .env only)
PROXYPAL_API_KEY=[REDACTED]
XKIRO_API_KEY=[REDACTED]
AIBOX_API_KEY=[REDACTED]
WORKER_POLL_SECONDS=60

# Durable usage ledger is enabled by default (requires reachable DATABASE_URL + migrations).
# Set false only for explicitly ephemeral/local deployments.
USAGE_LEDGER_DB_ENABLED=true
