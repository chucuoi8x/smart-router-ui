# Copy to .env and fill locally. Never commit .env or key material.
SMART_ROUTER_KEY=generate-a-long-random-local-secret
SMART_ROUTER_ENCRYPTION_KEY=generate-a-fernet-key-with-python
SMART_ROUTER_CONFIG=config.yaml
SMART_ROUTER_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:smart_router_secret@postgres:5432/smart_router
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=smart_router_secret
SMART_ROUTER_PORT=8320
WEB_PORT=80

# Opt-in durable usage ledger (requires reachable DATABASE_URL + migrations applied).
# Keep false unless you want every request's usage persisted to PostgreSQL.
USAGE_LEDGER_DB_ENABLED=false
